---
const { compact = false } = Astro.props;
---
<a class:list={["brand", { compact }]} href="/" aria-label="Typact 首页">
  <span class="brand-mark" aria-hidden="true">
    <span class="angle">‹</span><span class="t">T</span><span class="line"></span><span class="angle cyan">›</span>
  </span>
  {!compact && <span>Typact</span>}
</a>

<style>
  .brand { display: inline-flex; align-items: center; gap: .7rem; color: var(--ink); text-decoration: none; font-size: 1.15rem; font-weight: 750; letter-spacing: -.03em; }
  .brand-mark { display: inline-flex; align-items: center; height: 2rem; color: var(--accent); font-family: var(--mono); font-weight: 800; letter-spacing: -.18em; }
  .angle { font-size: 2rem; line-height: 1; }
  .angle.cyan { color: var(--cyan); }
  .t { font-size: 1.2rem; position: relative; z-index: 1; }
  .line { width: .52rem; height: 1px; background: linear-gradient(90deg, var(--accent), var(--cyan)); }
  .compact { gap: 0; }
</style>
