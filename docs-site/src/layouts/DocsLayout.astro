---
import Brand from '../components/Brand.astro';
import SourceLink from '../components/SourceLink.astro';
import '../styles/global.css';

const { frontmatter } = Astro.props;
const current = Astro.url.pathname;
const groups = [
  { title: 'Start', links: [['Getting started', '/docs/getting-started/'], ['Core concepts', '/docs/concepts/']] },
  { title: 'Guides', links: [['Annotations', '/docs/annotations/'], ['Runtimes', '/docs/runtime/'], ['Interceptors', '/docs/interceptors/'], ['Testing', '/docs/testing/']] },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={frontmatter.description ?? 'Typact documentation'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{frontmatter.title} · Typact</title>
    <script is:inline>document.documentElement.dataset.theme = localStorage.getItem('typact-theme') || 'dark';</script>
  </head>
  <body>
    <header class="topbar">
      <Brand />
      <nav class="top-actions" aria-label="Secondary navigation">
        <a href="/docs/getting-started/">Docs</a>
        <a href="https://github.com/zzqjlcn/typact/blob/main/README.zh-CN.md">中文</a>
        <SourceLink />
        <a href="https://pypi.org/project/typact/" target="_blank" rel="noreferrer">PyPI ↗</a>
        <button id="theme-toggle" aria-label="Toggle color theme">◐</button>
        <button id="menu-toggle" class="menu-toggle" aria-label="Open menu">Menu</button>
      </nav>
    </header>
    <div class="docs-shell">
      <aside class="sidebar" id="sidebar">
        <div class="version">Documentation <span>v0.2</span></div>
        {groups.map(group => <section>
          <h2>{group.title}</h2>
          {group.links.map(([label, href]) => <a class:list={{ active: current === href }} href={href}>{label}</a>)}
        </section>)}
      </aside>
      <main class="doc-main">
        <div class="eyebrow">TYPED HTTP CONTRACTS</div>
        <article class="prose"><slot /></article>
        <nav class="doc-footer">
          <span>Typact · MIT License</span>
          <a href="/">Back to home ↑</a>
        </nav>
      </main>
      <aside class="toc" aria-label="On this page"><strong>On this page</strong><nav id="toc-links"></nav></aside>
    </div>
    <script>
      const root = document.documentElement;
      document.querySelector('#theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next; localStorage.setItem('typact-theme', next);
      });
      document.querySelector('#menu-toggle')?.addEventListener('click', () => document.querySelector('#sidebar')?.classList.toggle('open'));
      const toc = document.querySelector('#toc-links');
      document.querySelectorAll('.prose h2').forEach((heading) => {
        const a = document.createElement('a'); a.href = `#${heading.id}`; a.textContent = heading.textContent; toc?.append(a);
      });
      document.querySelectorAll('pre').forEach((pre) => {
        const button = document.createElement('button'); button.className = 'copy'; button.textContent = 'Copy';
        button.addEventListener('click', async () => { await navigator.clipboard.writeText(pre.textContent || ''); button.textContent = 'Copied'; setTimeout(() => button.textContent = 'Copy', 1200); });
        pre.append(button);
      });
    </script>
  </body>
</html>
